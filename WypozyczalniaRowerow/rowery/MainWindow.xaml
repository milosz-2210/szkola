<Window x:Class="rowery.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wypożyczalnia rowerów"
        Height="750"
        Width="1150"
        MinHeight="650"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#EEF2F7">

    <!-- Główny układ okna -->
    <Grid Margin="20">

        <!-- Podział okna na dwa wiersze -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Nagłówek programu -->
        <TextBlock Text="WYPOŻYCZALNIA ROWERÓW"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#263B50"
                   Margin="0,0,0,20"/>

        <!-- Główna część programu -->
        <Grid Grid.Row="1">

            <!-- Podział na tabelę i panel obsługi -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- TABELA ROWERÓW -->
            <Border Background="White"
                    CornerRadius="10"
                    Padding="10"
                    Margin="0,0,15,0">

                <!-- Tabela wyświetlająca rowery -->
                <DataGrid x:Name="TabelaRowerow"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          RowHeight="35"
                          SelectionChanged="TabelaRowerow_SelectionChanged">

                    <!-- Kolumny tabeli -->
                    <DataGrid.Columns>

                        <DataGridTextColumn Header="ID"
                            Binding="{Binding Id}"
                            Width="50"/>

                        <DataGridTextColumn Header="Opis"
                            Binding="{Binding Opis}"
                            Width="*"/>

                        <DataGridTextColumn Header="Rodzaj"
                            Binding="{Binding Rodzaj}"
                            Width="90"/>

                        <DataGridTextColumn Header="Cena/h"
                            Binding="{Binding Cena, StringFormat={}{0:F2} zł}"
                            Width="85"/>

                        <DataGridTextColumn Header="Status"
                            Binding="{Binding Status}"
                            Width="110"/>

                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- PANEL OBSŁUGI PROGRAMU -->
            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="10"
                    Padding="15">

                <!-- Przewijanie panelu -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <!-- Nagłówek panelu -->
                        <TextBlock Text="Zarządzanie rowerami"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="#263B50"
                                   Margin="0,0,0,15"/>

                        <!-- Pole do wpisania ID -->
                        <TextBlock Text="ID roweru"/>
                        <TextBox x:Name="IdBox"
                                 Margin="0,5,0,10"
                                 Padding="7"/>

                        <!-- Pole do wpisania opisu -->
                        <TextBlock Text="Opis roweru"/>
                        <TextBox x:Name="OpisBox"
                                 Margin="0,5,0,10"
                                 Padding="7"/>

                        <!-- Wybór rodzaju roweru -->
                        <TextBlock Text="Rodzaj roweru"/>

                        <ComboBox x:Name="RodzajBox"
                                  Margin="0,5,0,10"
                                  Padding="7">

                            <ComboBoxItem Content="Górski"/>
                            <ComboBoxItem Content="Miejski"/>
                            <ComboBoxItem Content="Szosowy"/>

                        </ComboBox>

                        <!-- Pole do wpisania ceny -->
                        <TextBlock Text="Cena za godzinę"/>
                        <TextBox x:Name="CenaBox"
                                 Margin="0,5,0,15"
                                 Padding="7"/>

                        <!-- Przycisk dodawania roweru -->
                        <Button Content="DODAJ ROWER"
                                Click="DodajRower_Click"
                                Background="#263B50"
                                Foreground="White"
                                Padding="10"
                                Margin="0,0,0,8"/>

                        <!-- Przycisk wypożyczania roweru -->
                        <Button Content="WYPOŻYCZ ROWER"
                                Click="WypozyczRower_Click"
                                Background="#4CAF50"
                                Foreground="White"
                                Padding="10"
                                Margin="0,0,0,8"/>

                        <!-- Pole do wpisania liczby godzin -->
                        <TextBlock Text="Liczba godzin wypożyczenia"/>
                        <TextBox x:Name="GodzinyBox"
                                 Margin="0,5,0,10"
                                 Padding="7"/>

                        <!-- Przycisk zwracania roweru -->
                        <Button Content="ZWRÓĆ ROWER"
                                Click="ZwrocRower_Click"
                                Background="#2196F3"
                                Foreground="White"
                                Padding="10"
                                Margin="0,0,0,15"/>

                        <Separator Margin="0,5,0,10"/>

                        <!-- Nagłówek sekcji zdjęć -->
                        <TextBlock Text="Zdjęcie roweru"
                                   FontWeight="Bold"
                                   FontSize="17"
                                   Margin="0,0,0,10"/>

                        <!-- Miejsce wyświetlania zdjęcia roweru -->
                        <Border Background="#F1F4F8"
                                CornerRadius="8"
                                Height="170"
                                Padding="5">

                            <Image x:Name="ZdjecieRoweru"
                                   Stretch="Uniform"/>

                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>

        </Grid>
    </Grid>
</Window>
