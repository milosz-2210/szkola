<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Moja lista zakupów"
        Height="500"
        Width="420"
        MinHeight="400"
        MinWidth="350"
        WindowStartupLocation="CenterScreen"
        Background="DarkSeaGreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Nagłówek -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Lista zakupów"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#26344A"/>

            <TextBlock Text="Zaplanuj, co kupisz!"
                       FontSize="13"
                       Foreground="#526176"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Pole wpisywania produktu -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="ProductBox"
                     Height="38"
                     FontSize="14"
                     Padding="10,7"
                     VerticalContentAlignment="Center"
                     Margin="0,0,8,0"/>

            <Button Grid.Column="1"
                    Content="Dodaj"
                    Width="80"
                    Height="38"
                    Background="MediumSeaGreen"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Click="Add_Click"/>
        </Grid>

        <!-- Lista produktów -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                Padding="10">

            <ListBox x:Name="ShoppingList"
                     BorderThickness="0"
                     Background="White"
                     FontSize="15">

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Name}"
                                  IsChecked="{Binding IsBought,
                                      Mode=TwoWay,
                                      UpdateSourceTrigger=PropertyChanged}"
                                  FontSize="15"
                                  Padding="5"
                                  Margin="0,10"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>
        </Border>

        <!-- Przyciski na dole -->
        <Grid Grid.Row="3" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Content="Usuń kupione"
                    Height="38"
                    Margin="0,0,5,0"
                    Background="#E6EBF3"
                    Foreground="#26344A"
                    BorderThickness="0"
                    Click="RemoveBought_Click"/>

            <Button Grid.Column="1"
                    Content="Wyczyść listę"
                    Height="38"
                    Margin="5,0,0,0"
                    Background="#FCE5E5"
                    Foreground="#B42318"
                    BorderThickness="0"
                    Click="Clear_Click"/>
        </Grid>
    </Grid>
</Window>