<Window x:Class="form.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ankieta"
        Height="450"
        Width="750"
        WindowStartupLocation="CenterScreen">

    <!-- Grid dzieli okno na dwie kolumny -->
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <!-- Dwie kolumny o jednakowej szerokości -->
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEWA STRONA - ANKIETA -->
        <!-- StackPanel układa elementy jeden pod drugim -->
        <StackPanel Grid.Column="0" Margin="10">

            <!-- Nagłówek ankiety -->
            <TextBlock Text="ANKIETA"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <!-- Wybór płci -->
            <TextBlock Text="Płeć:" FontWeight="Bold"/>

            <!-- Orientation="Horizontal" ustawia opcje w jednym wierszu -->
            <!-- GroupName sprawia, że można wybrać tylko jedną opcję -->
            <StackPanel Orientation="Horizontal"
                        Margin="0,5,0,15">
                <RadioButton x:Name="rbMezczyzna"
                             Content="Mężczyzna"
                             GroupName="Plec"
                             Margin="0,0,10,0"/>

                <RadioButton x:Name="rbKobieta"
                             Content="Kobieta"
                             GroupName="Plec"
                             Margin="0,0,10,0"/>

                <RadioButton x:Name="rbInne"
                             Content="Inne"
                             GroupName="Plec"/>
            </StackPanel>

            <!-- Pole do wpisania wieku -->
            <TextBlock Text="Wiek:" FontWeight="Bold"/>

            <TextBox x:Name="txtWiek"
                     Height="28"
                     Margin="0,5,0,15"/>

            <!-- Lista rozwijana z wyborem koloru -->
            <TextBlock Text="Kolor:" FontWeight="Bold"/>

            <!-- SelectedIndex="0" oznacza zaznaczenie pierwszej pozycji -->
            <ComboBox x:Name="cmbKolor"
                      Height="28"
                      SelectedIndex="0"
                      Margin="0,5,0,15">

                <!-- Content określa nazwę opcji -->
                <!-- Background ustawia kolor tła, Foreground kolor tekstu -->
                <ComboBoxItem Content="Czerwony" Background="Red" Foreground="White"/>
                <ComboBoxItem Content="Niebieski" Background="Blue" Foreground="White"/>
                <ComboBoxItem Content="Zielony" Background="Green" Foreground="White"/>
                <ComboBoxItem Content="Żółty" Background="Yellow" Foreground="Black"/>
                <ComboBoxItem Content="Czarny" Background="Black" Foreground="White"/>
                <ComboBoxItem Content="Inny" Foreground="Black"/>
            </ComboBox>

            <!-- Zgoda użytkownika -->
            <TextBlock Text="Zgoda:" FontWeight="Bold"/>

            <!-- CheckBox pozwala zaznaczyć lub odznaczyć zgodę -->
            <CheckBox x:Name="chkZgoda"
                      Content="Wyrażam zgodę"
                      Margin="0,5,0,15"/>

            <!-- Kliknięcie przycisku uruchamia metodę Zapisz_Click w C# -->
            <Button Content="Zapisz"
                    Width="120"
                    Height="35"
                    HorizontalAlignment="Center"
                    Click="Zapisz_Click"/>

        </StackPanel>

        <!-- PRAWA STRONA - WYNIKI -->
        <!-- Tutaj wyświetlane są statystyki ankiety -->
        <StackPanel Grid.Column="1"
                    Margin="20,10,10,10">

            <!-- Nagłówek sekcji wyników -->
            <TextBlock Text="WYNIKI"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <!-- TextBlocki wyświetlają wyniki obliczone w kodzie C# -->
            <!-- x:Name pozwala odwołać się do elementu w kodzie C# -->

            <!-- Średnia wieku respondentów -->
            <TextBlock x:Name="txtSredniWiek"
                       Text="Średni wiek: 0"
                       FontSize="16"
                       Margin="0,5,0,15"
                       TextWrapping="Wrap"/>

            <!-- Najczęściej wybierany kolor -->
            <TextBlock x:Name="txtKolor"
                       Text="Najczęstszy kolor: brak"
                       FontSize="16"
                       Margin="0,5,0,15"
                       TextWrapping="Wrap"/>

            <!-- Liczba mężczyzn -->
            <TextBlock x:Name="txtMezczyzni"
                       Text="Liczba mężczyzn: 0"
                       FontSize="16"
                       Margin="0,5,0,15"/>

            <!-- Liczba kobiet -->
            <TextBlock x:Name="txtKobiety"
                       Text="Liczba kobiet: 0"
                       FontSize="16"
                       Margin="0,5,0,15"/>

            <!-- Liczba osób, które wyraziły zgodę -->
            <TextBlock x:Name="txtZgody"
                       Text="Liczba zgód: 0"
                       FontSize="16"
                       Margin="0,5,0,15"/>

        </StackPanel>
    </Grid>
</Window>
