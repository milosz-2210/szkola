
<Window x:Class="kalkulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mój kalkulator"

        Height="520" Width="360"
        MinHeight="520" MinWidth="360"
        MaxHeight="520" MaxWidth="360"

        WindowStartupLocation="CenterScreen"
        Background="#172033"
        ResizeMode="NoResize">

    <!-- STYLE PRZYCISKÓW -->
    <!-- Window.Resources przechowuje style, które można
         później przypisać do wielu przycisków. -->

    <Window.Resources>

        <!-- Styl cyfr od 0 do 9 -->
        <Style x:Key="Cyfra" TargetType="{x:Type Button}">
            <Setter Property="Margin" Value="4"/>
            <!-- Odstęp przycisku od innych przycisków -->
            <Setter Property="FontSize" Value="23"/>
            <!-- Wielkość tekstu na przycisku -->
            <Setter Property="FontWeight" Value="SemiBold"/>
            <!-- Grubość czcionki -->
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <!-- Kolor tekstu -->
            <Setter Property="Background" Value="#34425D"/>
            <!-- Kolor tła przycisku -->
            <Setter Property="BorderThickness" Value="0"/>
            <!-- Usunięcie obramowania -->
            <Setter Property="Cursor" Value="Hand"/>
            <!-- Kursor zmienia się w dłoń po najechaniu -->
        </Style>

        <!-- Styl przycisków działań: +, -, ×, ÷ -->
        <Style x:Key="Dzialanie" TargetType="{x:Type Button}">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#3984F5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Styl przycisków funkcyjnych: C i usuwanie -->
        <Style x:Key="Funkcyjny" TargetType="{x:Type Button}">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#53627D"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Styl przycisku równości -->
        <Style x:Key="Wynikowy" TargetType="{x:Type Button}">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#20B981"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Window.Resources>

    <!-- GŁÓWNY UKŁAD OKNA -->
    <Grid Margin="15">
        <!-- Grid dzieli okno na wiersze i kolumny.
             Margin ustawia odstęp zawartości od krawędzi. -->

        <Grid.RowDefinitions>
            <!-- Pierwszy wiersz na wyświetlacz wyniku -->
            <RowDefinition Height="90"/>

            <!-- Drugi wiersz zajmuje pozostałe miejsce -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- WYŚWIETLACZ WYNIKU -->
        <TextBox x:Name="Wynik"
                 Grid.Row="0"
                 Text="0"
                 FontSize="34"
                 FontWeight="Bold"
                 Foreground="White"
                 Background="#26334D"
                 BorderThickness="0"
                 TextAlignment="Right"
                 VerticalContentAlignment="Center"
                 IsReadOnly="True"
                 Padding="10"
                 Margin="0,0,0,12"/>

        <!-- x:Name="Wynik" pozwala odwołać się do pola w C#.
             IsReadOnly="True" blokuje ręczne wpisywanie.
             TextAlignment="Right" wyrównuje tekst do prawej.
             Text określa początkową wartość wyświetlacza. -->

        <!-- UKŁAD PRZYCISKÓW -->
        <UniformGrid Grid.Row="1"
                     Columns="4"
                     Rows="5">

            <!-- UniformGrid automatycznie rozmieszcza przyciski
                 w równych komórkach: 4 kolumny i 5 wierszy. -->

            <!-- CZYŚĆ I USUWANIE -->
            <Button Content="C"
                    Click="Wyczysc_Click"
                    Style="{StaticResource Funkcyjny}"/>

            <Button Content="⌫"
                    Click="Usun_Click"
                    Style="{StaticResource Funkcyjny}"/>

            <!-- DZIAŁANIA MATEMATYCZNE -->
            <Button Content="÷"
                    Click="Dzialanie_Click"
                    Style="{StaticResource Dzialanie}"/>

            <Button Content="×"
                    Click="Dzialanie_Click"
                    Style="{StaticResource Dzialanie}"/>

            <!-- CYFRY 7, 8, 9 I ODEJMOWANIE -->
            <Button Content="7"
                    Click="Cyfra_Click"
                    Style="{StaticResource Cyfra}"/>

            <Button Content="8"
                    Click="Cyfra_Click"
                    Style="{StaticResource Cyfra}"/>

            <Button Content="9"
                    Click="Cyfra_Click"
                    Style="{StaticResource Cyfra}"/>

            <Button Content="−"
                    Click="Dzialanie_Click"
                    Style="{StaticResource Dzialanie}"/>

            <!-- CYFRY 4, 5, 6 I DODAWANIE -->
            <Button Content="4"
                    Click="Cyfra_Click"
                    Style="{StaticResource Cyfra}"/>

            <Button Content="5"
                    Click="Cyfra_Click"
                    Style="{StaticResource Cyfra}"/>

            <Button Content="6"
                    Click="Cyfra_Click"
                    Style="{StaticResource Cyfra}"/>

            <Button Content="+"
                    Click="Dzialanie_Click"
                    Style="{StaticResource Dzialanie}"/>

            <!-- CYFRY 1, 2, 3 -->
            <Button Content="1"
                    Click="Cyfra_Click"
                    Style="{StaticResource Cyfra}"/>

            <Button Content="2"
                    Click="Cyfra_Click"
                    Style="{StaticResource Cyfra}"/>

            <Button Content="3"
                    Click="Cyfra_Click"
                    Style="{StaticResource Cyfra}"/>

            <!-- PRZYCISK RÓWNOŚCI -->
            <Button Content="="
                    Click="Wynik_Click"
                    Grid.RowSpan="2"
                    Style="{StaticResource Wynikowy}"
                    Margin="4,4,4,-73"/>

            <!-- Grid.RowSpan="2" określa rozciągnięcie na dwa wiersze.
                 Margin ustawia odstępy wokół przycisku. -->

            <!-- ZERO, ZMIANA ZNAKU I PRZECINEK -->
            <Button Content="±"
                    Click="Znak_Click"
                    Style="{StaticResource Funkcyjny}"/>

            <Button Content="0"
                    Click="Cyfra_Click"
                    Style="{StaticResource Cyfra}"/>

            <Button Content=","
                    Click="Przecinek_Click"
                    Style="{StaticResource Cyfra}"/>

        </UniformGrid>
    </Grid>
</Window>
